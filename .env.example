PORT=8787
# Loopback only by default. Set to 0.0.0.0 to expose the API on the LAN.
# The app has no authentication, so only do that deliberately.
HOST=127.0.0.1
DATABASE_PATH=./data/command-center.db
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/drive/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# fatal, error, warn, info, debug, trace, or silent. Anything else falls back to info.
LOG_LEVEL=info

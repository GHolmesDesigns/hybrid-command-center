# Every variable here is validated when the server starts. A value the schema refuses stops the
# boot with a message naming the variable, rather than failing later at the browser. Leaving one
# blank is the same as leaving it out: the default below is used.
PORT=8787
# Loopback only by default: 127.0.0.1, ::1, or localhost. A non-loopback HOST is refused until
# operator authentication is fully configured — SESSION_SECRET, OPERATOR_PASSWORD_HASH, an
# https APP_ORIGIN, PRODUCTION_TLS_TERMINATED=true, and TRUSTED_PROXY_HOPS set explicitly.
# See docs/cloud-hosting.md §5.1.
HOST=127.0.0.1
DATABASE_PATH=./data/command-center.db
# An http or https URL, scheme included. This is the CORS origin the API answers. Production
# binds require https.
APP_ORIGIN=http://localhost:5173
# Drive is optional: leave all three Google values blank and the app runs with Drive reporting
# itself unconfigured. A value that is present has to be usable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/drive/oauth/callback
# At least 32 characters. This is hashed into the key that encrypts OAuth tokens at rest, so a
# short one is accepted by the cipher and protects nothing.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Publishing is optional. Both values are required before the preview can submit anything.
POST_BRIDGE_API_KEY=
PUBLISH_TIMEZONE=
# Buffer is optional. When present it supplies read-only TikTok and YouTube account metadata for
# publishing previews; publishing itself still uses Post Bridge until a later card. BUFFER_KEY is a
# one-release migration alias; BUFFER_API_KEY wins when both are present.
BUFFER_API_KEY=
BUFFER_KEY=
# Required when the Buffer account has more than one organization. When exactly one organization
# exists, it is chosen automatically.
BUFFER_ORGANIZATION_ID=
# fatal, error, warn, info, debug, trace, or silent. Anything else falls back to info.
LOG_LEVEL=info
# Operator authentication (C51). Optional on loopback. Together with an https APP_ORIGIN,
# PRODUCTION_TLS_TERMINATED=true, and an explicit TRUSTED_PROXY_HOPS they open a non-loopback bind.
# SESSION_SECRET must be at least 32 characters when set. OPERATOR_PASSWORD_HASH is an argon2id
# hash — never a plaintext password.
SESSION_SECRET=
OPERATOR_PASSWORD_HASH=
# Exact token `true` when TLS terminates in front of the process. Any other value is refused.
PRODUCTION_TLS_TERMINATED=
# How many reverse proxies sit in front of the process (0 = ignore X-Forwarded-For). Must be set
# explicitly for a non-loopback bind, even to 0.
TRUSTED_PROXY_HOPS=0

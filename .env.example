# Every variable here is validated when the server starts. A value the schema refuses stops the
# boot with a message naming the variable, rather than failing later at the browser. Leaving one
# blank is the same as leaving it out: the default below is used.
PORT=8787
# Loopback only by default. Set to 0.0.0.0 to expose the API on the LAN.
# The app has no authentication, so only do that deliberately.
HOST=127.0.0.1
DATABASE_PATH=./data/command-center.db
# An http or https URL, scheme included. This is the CORS origin the API answers.
APP_ORIGIN=http://localhost:5173
# Drive is optional: leave all three Google values blank and the app runs with Drive reporting
# itself unconfigured. A value that is present has to be usable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/drive/oauth/callback
# At least 32 characters. This is hashed into the key that encrypts OAuth tokens at rest, so a
# short one is accepted by the cipher and protects nothing.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# fatal, error, warn, info, debug, trace, or silent. Anything else falls back to info.
LOG_LEVEL=info

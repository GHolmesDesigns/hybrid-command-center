{
  "name": "hybrid-command-center",
  "version": "6.8.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "build:production-artifact": "npm run build && node --experimental-strip-types scripts/build-production-artifact.ts",
    "start": "node --experimental-strip-types server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:version-bump": "node --experimental-strip-types server/scripts/check-version-bump.ts",
    "check:manual-version": "node --experimental-strip-types server/scripts/check-manual-version.ts",
    "db:migrate": "node --experimental-strip-types server/scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types server/scripts/seed.ts",
    "auth:bootstrap": "node --experimental-strip-types server/scripts/bootstrap-operator.ts",
    "probe:post-bridge": "node --experimental-strip-types scripts/probe-post-bridge.ts",
    "probe:buffer": "node --experimental-strip-types scripts/probe-buffer.ts",
    "probe:agent-cost": "node --experimental-strip-types scripts/probe-agent-cost.ts",
    "eval:mcp-smoke": "node --experimental-strip-types scripts/eval-mcp-smoke.ts",
    "test:eval-mcp": "vitest run --project server server/mcp/agent-evaluation.test.ts",
    "signal:import": "node --experimental-strip-types server/scripts/import-signal-archive.ts",
    "signal:backfill": "node --experimental-strip-types server/scripts/backfill-signal-assignment.ts",
    "mcp": "node --experimental-strip-types server/scripts/mcp.ts",
    "db:backup": "node --experimental-strip-types server/scripts/backup.ts",
    "db:restore": "node --experimental-strip-types server/scripts/restore.ts",
    "db:backup:rehearse": "node --experimental-strip-types server/scripts/rehearse-backup.ts",
    "db:backup:offsite": "node --experimental-strip-types server/scripts/offsite-backup.ts backup",
    "db:backup:offsite:rehearse": "node --experimental-strip-types server/scripts/offsite-backup.ts rehearse",
    "db:backup:health": "node --experimental-strip-types server/scripts/offsite-backup.ts health",
    "cutover:rehearse": "node --experimental-strip-types server/scripts/cutover-rehearsal.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.41.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "smol-toml": "1.8.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

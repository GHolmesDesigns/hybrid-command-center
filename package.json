{
  "name": "hybrid-command-center",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "start": "node --experimental-strip-types server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:api": "cross-env PORT=8788 DATABASE_PATH=./data/e2e.db APP_ORIGIN=http://127.0.0.1:5174 node --experimental-strip-types e2e/start-server.ts",
    "test:e2e:web": "cross-env API_PORT=8788 vite --host 127.0.0.1 --port 5174",
    "db:migrate": "node --experimental-strip-types server/scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types server/scripts/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@dnd-kit/utilities": "latest",
    "cors": "latest",
    "date-fns": "latest",
    "dotenv": "latest",
    "express": "latest",
    "googleapis": "latest",
    "helmet": "latest",
    "lucide-react": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "supertest": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/hybrid-command-center/command-center.db
APP_ORIGIN=https://command-center.example.com
GOOGLE_REDIRECT_URI=https://command-center.example.com/api/drive/oauth/callback
PRODUCTION_TLS_TERMINATED=true
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info

# Loaded from SSM Parameter Store by the deploy process. Never commit real values.
SESSION_SECRET=UNSET
OPERATOR_PASSWORD_HASH=UNSET
GOOGLE_CLIENT_ID=UNSET
GOOGLE_CLIENT_SECRET=UNSET
GOOGLE_TOKEN_ENCRYPTION_KEY=UNSET
GOOGLE_API_KEY=UNSET
GOOGLE_APP_ID=UNSET
# Off-site backup identifiers are not secrets. The Drive-token key still comes from the separate
# SSM parameter loaded by the host bootstrap; it must never be placed in the backup bucket.
HCC_BACKUP_BUCKET=hcc-production-backups-233171357361
HCC_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:233171357361:hcc-production-alerts
HCC_BACKUP_DIR=/var/lib/hybrid-command-center/backups
HCC_BACKUP_STATE_DIR=/var/lib/hybrid-command-center/backup-state

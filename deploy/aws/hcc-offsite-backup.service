[Unit]
Description=Hybrid Command Center encrypted off-site backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hcc
Group=hcc
WorkingDirectory=/opt/hybrid-command-center/current
EnvironmentFile=/etc/hybrid-command-center/runtime.env
ExecStart=/usr/bin/node --experimental-strip-types server/scripts/offsite-backup.ts backup
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hybrid-command-center

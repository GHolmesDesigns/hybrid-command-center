[Unit]
Description=Hybrid Command Center backup and disk health check

[Service]
Type=oneshot
User=hcc
Group=hcc
WorkingDirectory=/opt/hybrid-command-center/current
EnvironmentFile=/etc/hybrid-command-center/runtime.env
ExecStart=/usr/bin/node --experimental-strip-types server/scripts/offsite-backup.ts health
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hybrid-command-center
